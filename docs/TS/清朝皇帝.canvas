{
	"nodes":[
		{"id":"title","type":"text","x":-200,"y":-400,"width":600,"height":150,"color":"1","content":"清朝皇帝时间线\n\n1616年 - 1912年\n共12位皇帝 296年历史\n\n清朝是中国历史上最后一个封建王朝"},
		{"id":"n1","type":"text","x":-1000,"y":0,"width":300,"height":300,"color":"1","content":"努尔哈赤\n太祖 天命\n\n在位: 1616-1626\n生卒: 1559-1626\n\n后金建立者\n统一女真各部\n创建八旗制度\n萨尔浒之战大败明军"},
		{"id":"n2","type":"text","x":-650,"y":0,"width":300,"height":300,"color":"1","content":"皇太极\n太宗 天聪/崇德\n\n在位: 1626-1643\n生卒: 1592-1643\n\n改国号为清\n建立清朝政权\n征服朝鲜统一蒙古"},
		{"id":"n3","type":"text","x":-300,"y":0,"width":300,"height":300,"color":"1","content":"顺治 福临\n世祖\n\n在位: 1644-1661\n生卒: 1638-1661\n\n清军入关\n定都北京\n董鄂妃故事"},
		{"id":"n4","type":"text","x":50,"y":0,"width":350,"height":350,"color":"5","content":"康熙 玄烨\n圣祖\n\n在位: 1662-1722 (61年)\n生卒: 1654-1722\n\n在位61年 中国历史最长\n智擒鳌拜\n平定三藩\n收复台湾\n亲征噶尔丹\n康乾盛世开始"},
		{"id":"n5","type":"text","x":450,"y":0,"width":350,"height":350,"color":"5","content":"雍正 胤禛\n世宗\n\n在位: 1723-1735\n生卒: 1678-1735\n\n九子夺嫡继位\n摊丁入亩改革\n设立军机处\n勤政著称"},
		{"id":"n6","type":"text","x":850,"y":0,"width":350,"height":380,"color":"5","content":"乾隆 弘历\n高宗\n\n在位: 1736-1795 (60年)\n生卒: 1711-1799\n\n十全武功\n四库全书\n六下江南\n盛世顶峰\n晚年宠信和珅"},
		{"id":"n7","type":"text","x":1250,"y":0,"width":300,"height":280,"color":"3","content":"嘉庆 颙琰\n仁宗\n\n在位: 1796-1820\n生卒: 1760-1820\n\n诛和珅\n白莲教起义\n由盛转衰"},
		{"id":"n8","type":"text","x":1600,"y":0,"width":300,"height":300,"color":"2","content":"道光 旻宁\n宣宗\n\n在位: 1821-1850\n生卒: 1782-1850\n\n第一次鸦片战争\n南京条约\n中国近代史开端"},
		{"id":"n9","type":"text","x":1950,"y":0,"width":300,"height":320,"color":"2","content":"咸丰 奕詝\n文宗\n\n在位: 1851-1861\n生卒: 1831-1861\n\n太平天国运动\n第二次鸦片战争\n火烧圆明园"},
		{"id":"n10","type":"text","x":2300,"y":0,"width":300,"height":280,"color":"2","content":"同治 载淳\n穆宗\n\n在位: 1862-1874\n生卒: 1856-1874\n\n慈禧垂帘听政\n洋务运动开始"},
		{"id":"n11","type":"text","x":2650,"y":0,"width":320,"height":350,"color":"2","content":"光绪 载湉\n德宗\n\n在位: 1875-1908\n生卒: 1871-1908\n\n甲午战争\n戊戌变法百日\n八国联军侵华"},
		{"id":"n12","type":"text","x":3020,"y":0,"width":320,"height":350,"color":"6","content":"溥仪\n末代皇帝\n\n在位: 1909-1912\n生卒: 1906-1967\n\n1912年退位清朝灭亡\n伪满洲国皇帝\n最后一位皇帝"},
		{"id":"events","type":"text","x":0,"y":-700,"width":500,"height":250,"color":"4","content":"重大历史事件\n\n开国时期\n1616 努尔哈赤建立后金\n1636 皇太极改国号为清\n1644 清军入关\n\n康乾盛世\n1662-1722 康熙在位61年\n1723-1735 雍正改革\n1736-1795 乾隆盛世"},
		{"id":"decline","type":"text","x":600,"y":-700,"width":500,"height":280,"color":"2","content":"衰落灭亡\n\n1840-1842 第一次鸦片战争\n1851-1864 太平天国运动\n1856-1860 第二次鸦片战争\n1894-1895 甲午战争\n1898 戊戌变法\n1900 八国联军\n1911 辛亥革命\n1912 溥仪退位"},
		{"id":"culture","type":"text","x":1200,"y":-700,"width":400,"height":300,"color":"3","content":"文化成就\n\n典籍\n康熙字典\n四库全书\n古今图书集成\n\n艺术\n康雍乾瓷器\n圆明园\n颐和园\n\n教训\n闭关锁国落后\n落后就要挨打"}
	],
